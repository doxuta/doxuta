erDiagram
  DEVICE_MODELS ||--o{ DEVICES : "gồm"
  DEVICES ||--o{ ORDERS : "được gán"
  DEVICES ||--o{ MAINTENANCE_LOGS : "có lịch sử"
  DEVICES ||--o{ INCIDENTS : "liên quan"
  ORDERS ||--o{ HANDOVERS : "có biên bản"
  ORDERS ||--o{ INCIDENTS : "phát sinh"
